# Copy to Backend/.env and edit. With Docker Compose, the hosts for Mongo/Qdrant/Ollama
# are set by docker-compose.yml, so only the secrets and model names matter there.

NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- MongoDB ---
# Port 27018 = the MongoDB started by docker-compose.yml (avoids clashing with a MongoDB installed on the host).
# Inside Docker Compose this value is overridden automatically.
MONGO_URI=mongodb://127.0.0.1:27018/tapas-kiran

# --- Auth ---
# Long random string. Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
# The first super_admin, created on startup if none exists. Change the password after first login.
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=change-me-please

# --- Ollama (local models) ---
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3
EMBED_DIM=1024
TEMPERATURE=0.1
# Context window in tokens. Must fit 4 retrieved chunks + prompt + answer.
NUM_CTX=8192
# Abort if Ollama sends nothing for this long (CPU-only machines can be slow)
OLLAMA_TIMEOUT_MS=120000

# --- Qdrant (vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tapas_kiran_chunks

# --- Uploads & OCR ---
MAX_UPLOAD_MB=50
# OCR for scanned PDFs. Needs tesseract.js + @napi-rs/canvas and local language data.
OCR_ENABLED=false
OCR_LANG_PATH=

# --- Limits ---
QUERY_RATE_LIMIT_PER_MIN=10

# --- Optional web search (OFF by default) ---
# When enabled, an officer can tick "also search the web" for a question. That question is
# then sent to Tavily over the internet. Leave false for a fully offline deployment.
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
