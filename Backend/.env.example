# ============================================================
# TAPAS KIRAN AI — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/investigation-assistant

# JWT
JWT_SECRET=your_jwt_secret_here

# Admin
ADMIN_SECRET=your_admin_secret_here

# Email (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# ─────────────────────────────────────────
# TAPAS KIRAN AI Configuration
# ─────────────────────────────────────────

# OpenAI API Key (Required for GPT-4o + embeddings)
OPENAI_API_KEY=sk-...

# OpenAI Model (default: gpt-4o — best for legal, bilingual tasks)
OPENAI_MODEL=gpt-4o

# Tavily Search API Key (Optional — for real-time case law / web search)
# Get free key at: https://tavily.com
TAVILY_API_KEY=tvly-...

# Google Gemini (Alternative to OpenAI — Optional)
GOOGLE_API_KEY=your_google_api_key_here
